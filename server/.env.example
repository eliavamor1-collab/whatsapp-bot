# Firebase Admin SDK - path to your service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account-key.json

# Server port
PORT=3000

# Cron schedule for checking updates (default: every 30 minutes)
CRON_SCHEDULE=*/30 * * * *

# Render deployment URL (enables self-ping to prevent sleeping)
# Example: https://version-tracker-xxxx.onrender.com
RENDER_URL=
